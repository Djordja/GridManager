@model FurnitureFactoryManager.Models.ProjectTask
@{
    var initials = string.IsNullOrWhiteSpace(Model.AssignedTo)
        ? "?"
        : Model.AssignedTo.Trim().Substring(0, 1).ToUpperInvariant();
}
<div class="task-card shadow-sm rounded p-3 mb-3" draggable="true" data-task-id="@Model.Id" data-status="@Model.Status">
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
            <span class="badge bg-secondary">@Model.ProjectName</span>
            <h3 class="h6 mt-2 mb-0">@Model.Title</h3>
        </div>
        <span class="badge text-bg-light text-uppercase small">@Model.Status</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="text-muted small mb-3">@Model.Description</p>
    }
    <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <div class="avatar-small bg-primary text-white rounded-circle">@initials</div>
            <span class="small">@Model.AssignedTo</span>
        </div>
        <button type="button" class="btn btn-outline-primary btn-sm" disabled>Detalji</button>
    </div>
</div>
